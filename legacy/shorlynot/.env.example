# ============================================================
# SHORLYNOT — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# Secret variables are marked with [SECRET].

# --- Execution Mode ---
# Options: simulation | real | replay
SHORLYNOT_EXECUTION_MODE=simulation

# --- Database ---
DATABASE_URL=sqlite:///./runtime/shorlynot.db

# --- Control Plane ---
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8000

# --- Router Agent ---
ROUTER_AGENT_URL=http://192.168.1.1:9100
ROUTER_REQUEST_TIMEOUT_SECONDS=5

# --- Signing Keys ---
# Path to Ed25519 private key PEM for control-plane lease signing
CONTROL_PLANE_SIGNING_PRIVATE_KEY_PATH=
# Path to Ed25519 public key PEM for router-side lease verification
ROUTER_SIGNING_PUBLIC_KEY_PATH=

# --- IBM Quantum [SECRET] ---
# Required only when SHORLYNOT_EXECUTION_MODE=real
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_BACKEND=

# --- QKD Thresholds ---
QKD_QBER_WARNING_THRESHOLD=0.08
QKD_QBER_COMPROMISE_THRESHOLD=0.11
QKD_CHSH_THRESHOLD=2.0
QKD_SECURITY_EPSILON=1e-10
QKD_MIN_FINAL_KEY_BITS=128

# --- QKBNL Lease ---
QKBNL_DEFAULT_TTL_SECONDS=60
QKBNL_MAX_CLOCK_SKEW_SECONDS=5

# --- Arduino / Optical Telemetry ---
# Serial port for Arduino connection (e.g., COM3 on Windows, /dev/ttyUSB0 on Linux)
ARDUINO_SERIAL_PORT=
ARDUINO_BAUDRATE=115200
ARDUINO_DARK_LEVEL=
ARDUINO_BRIGHT_LEVEL=
ARDUINO_DECISION_THRESHOLD=0.5

# --- PQC ---
# Options: ML-KEM-512 | ML-KEM-768 | ML-KEM-1024
MLKEM_VARIANT=ML-KEM-768

# --- Logging ---
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
