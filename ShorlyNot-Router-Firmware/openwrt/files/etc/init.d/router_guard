#!/bin/sh /etc/rc.common
# Make sure to run `chmod +x` on this file!

START=99
USE_PROCD=1

start_service() {
    local enabled
    local kms_host kms_port relay_port poll_interval fail_action max_failures

    config_load router_guard
    config_get_bool enabled main enabled 0

    if [ "$enabled" -ne 1 ]; then
        return 1
    fi

    config_get kms_host main kms_host "192.168.1.2"
    config_get kms_port main kms_port "8000"
    config_get relay_port main relay_port "8765"
    config_get poll_interval main poll_interval "3"
    config_get fail_action main fail_action "block"
    config_get max_failures main max_failures "5"


    procd_open_instance
    procd_set_param command /usr/bin/router_guard.sh
    procd_set_param env KMS_URL="http://${kms_host}:${kms_port}" \
                        RELAY_PORT="$relay_port" \
                        POLL_INTERVAL="$poll_interval" \
                        FAIL_ACTION="$fail_action" \
                        MAX_FAILURES="$max_failures"
    
    # respawn: threshold 600s, wait 10s between retries, max 5 retries
    procd_set_param respawn 600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# procd sends SIGTERM on stop, which triggers cleanup() in router_guard.sh.
# No stop_service() needed — procd manages the process lifecycle.

service_triggers() {
    procd_add_reload_trigger "router_guard"
}

reload_service() {
    stop
    start
}
